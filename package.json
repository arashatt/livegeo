{
  "name": "telegram-live-location",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "A live map of locations people share with a Telegram bot, or with an account over MTProto.",
  "scripts": {
    "start": "node src/index.js",
    "login": "node bin/login.mjs",
    "test": "node test/test.mjs && node --test test/cartography.test.mjs test/vector-tiles.test.mjs && node test/game-smoke.mjs",
    "test:cartography": "node test/cartography-postgis.mjs",
    "glyphs": "node bin/glyphs.mjs",
    "test:browser": "node test/game-smoke.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "pg": "^8.23.0",
    "teleproto": "^1.229.0"
  },
  "devDependencies": {
    "@mapbox/vector-tile": "2.0.4",
    "@sakitam-gis/font-maker-cli": "1.0.0",
    "geojson-vt": "4.0.3",
    "pbf": "4.0.1",
    "playwright-core": "1.58.2",
    "vt-pbf": "3.1.3"
  }
}
